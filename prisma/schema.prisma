// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  name                String?
  email               String              @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?             // Optional because Google users won't have it initially
  phone               String?
  sessionVersion      Int                 @default(0)
  role                String              @default("CLIENT") // ADMIN, BARBER, CLIENT, RECEPTIONIST
  active              Boolean             @default(true)     // Soft delete status
  accounts            Account[]
  sessions            Session[]
  appointments        Appointment[]       @relation("ClientAppointments")
  createdAppointments Appointment[]       @relation("CreatedAppointments")
  confirmedReceipts   PaymentReceipt[]    @relation("ConfirmedReceipts")
  revertedReceipts    PaymentReversal[]   @relation("RevertedReceipts")
  createdExpenses     Expense[]           @relation("CreatedExpenses")
  paidExpenses              Expense[]                 @relation("PaidExpenses")
  paidCommissions           CommissionPayout[]        @relation("PaidCommissions")
  financialMovements        FinancialMovement[]       @relation("ActorFinancialMovements")
  linkedClientContacts      ClientIdentityLink[]      @relation("LinkedClientContacts")
  auditedIdentityLinks      ClientIdentityLink[]      @relation("AuditedIdentityLinks")
  createdScheduleExceptions BarberScheduleException[] @relation("CreatedScheduleExceptions")
  notifications             Notification[]
  barber                    Barber?
  receptionist              Receptionist?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

model Receptionist {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientContact {
  id           String              @id @default(cuid())
  name         String
  phone        String?
  email        String?
  appointments Appointment[]
  identityLink ClientIdentityLink?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([name])
  @@index([phone])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Barber {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDays           Int[]                     // Array of weekday numbers: 0 (Sunday) to 6 (Saturday)
  workStart          String                    // HH:MM (e.g. "09:00")
  workEnd            String                    // HH:MM (e.g. "18:00")
  appointments       Appointment[]
  commissionPayouts  CommissionPayout[]
  scheduleExceptions BarberScheduleException[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Service {
  id               String        @id @default(cuid())
  name             String
  price            Decimal       @db.Decimal(12, 2)
  durationMinutes  Int
  commissionRate   Decimal       @db.Decimal(5, 4)         // e.g. 0.40 for 40% (RN09.2)
  image            String?
  active           Boolean       @default(true)
  appointments     Appointment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Appointment {
  id              String                   @id @default(cuid())
  clientId        String?
  client          User?                    @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  clientContactId String?
  clientContact   ClientContact?           @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  barberId        String
  barber          Barber                   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime
  status          String                   @default("PENDING") // PENDING, COMPLETED, CANCELED, NO_SHOW (RN07.1)
  origin          String                   @default("ONLINE")  // ONLINE, WHATSAPP, WALK_IN
  createdById     String?
  createdBy       User?                    @relation("CreatedAppointments", fields: [createdById], references: [id], onDelete: SetNull)
  priceCents      Int
  commissionCents Int
  reminded24h     Boolean                  @default(false)
  reminded1h      Boolean                  @default(false)
  reminded15m     Boolean                  @default(false)
  remindedStart   Boolean                  @default(false)
  receipt         PaymentReceipt?
  statusEvents    AppointmentStatusEvent[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([barberId, startTime, endTime])
  @@index([clientId, startTime])
  @@index([clientContactId, startTime])
  @@index([status, startTime])
  @@index([createdById])
}

model PaymentReceipt {
  id             String           @id @default(cuid())
  appointmentId  String           @unique
  appointment    Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amountCents    Int
  method         String           // MONEY, PIX, CARD
  confirmedById  String
  confirmedBy    User             @relation("ConfirmedReceipts", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt    DateTime         @default(now())
  idempotencyKey String?          @unique
  status         String           @default("CONFIRMED") // CONFIRMED, REVERSED, REFUNDED
  reversal       PaymentReversal?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([confirmedAt])
  @@index([method, confirmedAt])
  @@index([status, confirmedAt])
}

model PaymentReversal {
  id             String         @id @default(cuid())
  receiptId      String         @unique
  receipt        PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  reason         String
  type           String         @default("RECORD_CORRECTION") // RECORD_CORRECTION, CLIENT_REFUND
  revertedById   String
  revertedBy     User           @relation("RevertedReceipts", fields: [revertedById], references: [id], onDelete: Restrict)
  revertedAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([revertedAt])
}

model Expense {
  id             String    @id @default(cuid())
  category       String    // RENT, UTILITIES, SUPPLIES, EQUIPMENT, MARKETING, TAXES, FIXED_PAYROLL, DIRECT_FEE, OTHER
  description    String
  supplier       String?
  amountCents    Int
  competenceDate DateTime
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  String?   // PIX, MONEY, CARD, TRANSFER
  status         String    @default("PENDING") // PENDING, PAID, CANCELED
  createdById    String
  createdBy      User      @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)
  paidById       String?
  paidBy         User?     @relation("PaidExpenses", fields: [paidById], references: [id], onDelete: Restrict)
  canceledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([competenceDate, status])
  @@index([dueDate, status])
  @@index([paidAt, status])
  @@index([category, competenceDate])
}

model CommissionPayout {
  id             String    @id @default(cuid())
  barberId       String
  barber         Barber    @relation(fields: [barberId], references: [id], onDelete: Restrict)
  amountCents    Int
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime  @default(now())
  paymentMethod  String    // PIX, MONEY, TRANSFER
  notes          String?
  paidById       String
  paidBy         User      @relation("PaidCommissions", fields: [paidById], references: [id], onDelete: Restrict)
  status         String    @default("PAID") // PAID, REVERSED
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([barberId, paidAt])
  @@index([status, paidAt])
}

model FinancialMovement {
  id             String   @id @default(cuid())
  type           String   // RECEIPT_IN, RECORD_CORRECTION, CLIENT_REFUND_OUT, EXPENSE_OUT, COMMISSION_PAYOUT_OUT
  amountCents    Int
  occurredAt     DateTime @default(now())
  recordedAt     DateTime @default(now())
  method         String?
  description    String
  reason         String?
  appointmentId  String?
  receiptId      String?
  expenseId      String?
  payoutId       String?
  actorId        String
  actor          User     @relation("ActorFinancialMovements", fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey String?  @unique

  @@index([occurredAt, type])
  @@index([receiptId])
  @@index([expenseId])
  @@index([payoutId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("INFO") // INFO, REMINDER, ALERT, CANCEL, NO_SHOW
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read, createdAt])
}

model ClientIdentityLink {
  id              String        @id @default(cuid())
  clientContactId String        @unique
  clientContact   ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  canonicalUserId String
  canonicalUser   User          @relation("LinkedClientContacts", fields: [canonicalUserId], references: [id], onDelete: Cascade)
  linkedById      String
  linkedBy        User          @relation("AuditedIdentityLinks", fields: [linkedById], references: [id], onDelete: Restrict)
  reason          String?
  active          Boolean       @default(true)
  linkedAt        DateTime      @default(now())
  unlinkedAt      DateTime?

  @@index([canonicalUserId, active])
}

model BarberScheduleException {
  id          String   @id @default(cuid())
  barberId    String
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  kind        String   // PAUSE, BLOCK, VACATION, EXTRA_SHIFT
  startTime   DateTime
  endTime     DateTime
  reason      String?
  createdById String
  createdBy   User     @relation("CreatedScheduleExceptions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([barberId, startTime, endTime])
}

model AppointmentStatusEvent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String      // COMPLETED, CANCELED, NO_SHOW, PENDING
  reasonCode    String?     // CLIENT_REQUEST, BARBER_UNAVAILABLE, WEATHER_TRAFFIC, DUPLICATE_BOOKING, NO_SHOW_UNNOTIFIED, OTHER
  notes         String?
  actorId       String?
  occurredAt    DateTime    @default(now())

  @@index([appointmentId, occurredAt])
  @@index([toStatus, occurredAt])
}

model InternalTelemetryEvent {
  id             String   @id @default(cuid())
  eventName      String   // booking_started, booking_details_selected, appointment_created, appointment_completed, appointment_canceled, appointment_no_show_marked, payment_confirmed, payment_record_reversed, payment_refunded, expense_recognized, expense_paid, commission_paid, report_exported
  schemaVersion  Int      @default(1)
  journeyId      String?
  channel        String?  // ONLINE, WHATSAPP, WALK_IN
  actorRole      String?  // CLIENT, RECEPTIONIST, BARBER, ADMIN
  appointmentId  String?
  serviceId      String?
  barberId       String?
  amountCents    Int?
  metadataJson   String?  // Non-PII JSON metadata
  idempotencyKey String?  @unique
  occurredAt     DateTime @default(now())

  @@index([eventName, occurredAt])
  @@index([journeyId, eventName])
}

model ManagementGoal {
  id          String   @id @default(cuid())
  metricCode  String   // RECEIVED_REVENUE_CENTS, REALIZED_PRODUCTION_CENTS, BARBERSHOP_CONTRIBUTION_CENTS, OCCUPANCY_RATE_PERCENT, EXPENSE_CEILING_CENTS, NO_SHOW_MAX_RATE_PERCENT
  monthKey    String   // "YYYY-MM"
  barberId    String   @default("ALL") // "ALL" or specific barberId
  targetValue Int      // Cents for CENTS metrics, or basis points / tenths of percent for PERCENT metrics
  unit        String   // CENTS, PERCENT_TENTHS
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([metricCode, monthKey, barberId])
  @@index([monthKey])
}




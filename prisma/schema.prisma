// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(cuid())
  name                String?
  email               String            @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?           // Optional because Google users won't have it initially
  phone               String?
  sessionVersion      Int               @default(0)
  role                String            @default("CLIENT") // ADMIN, BARBER, CLIENT, RECEPTIONIST
  active              Boolean           @default(true)     // Soft delete status
  accounts            Account[]
  sessions            Session[]
  appointments        Appointment[]     @relation("ClientAppointments")
  createdAppointments Appointment[]     @relation("CreatedAppointments")
  confirmedReceipts   PaymentReceipt[]  @relation("ConfirmedReceipts")
  revertedReceipts    PaymentReversal[] @relation("RevertedReceipts")
  notifications       Notification[]
  barber              Barber?
  receptionist        Receptionist?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Receptionist {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientContact {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([phone])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Barber {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDays     Int[]         // Array of weekday numbers: 0 (Sunday) to 6 (Saturday)
  workStart    String        // HH:MM (e.g. "09:00")
  workEnd      String        // HH:MM (e.g. "18:00")
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id               String        @id @default(cuid())
  name             String
  price            Decimal       @db.Decimal(12, 2)
  durationMinutes  Int
  commissionRate   Decimal       @db.Decimal(5, 4)         // e.g. 0.40 for 40% (RN09.2)
  image            String?
  active           Boolean       @default(true)
  appointments     Appointment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Appointment {
  id              String          @id @default(cuid())
  clientId        String?
  client          User?           @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  clientContactId String?
  clientContact   ClientContact?  @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  barberId        String
  barber          Barber          @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime
  status          String          @default("PENDING") // PENDING, COMPLETED, CANCELED, NO_SHOW (RN07.1)
  origin          String          @default("ONLINE")  // ONLINE, WHATSAPP, WALK_IN
  createdById     String?
  createdBy       User?           @relation("CreatedAppointments", fields: [createdById], references: [id], onDelete: SetNull)
  priceCents      Int
  commissionCents Int
  reminded24h     Boolean         @default(false)
  reminded1h      Boolean         @default(false)
  reminded15m     Boolean         @default(false)
  remindedStart   Boolean         @default(false)
  receipt         PaymentReceipt?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([barberId, startTime, endTime])
  @@index([clientId, startTime])
  @@index([clientContactId, startTime])
  @@index([status, startTime])
  @@index([createdById])
}

model PaymentReceipt {
  id             String           @id @default(cuid())
  appointmentId  String           @unique
  appointment    Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amountCents    Int
  method         String           // MONEY, PIX, CARD
  confirmedById  String
  confirmedBy    User             @relation("ConfirmedReceipts", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt    DateTime         @default(now())
  idempotencyKey String?          @unique
  status         String           @default("CONFIRMED") // CONFIRMED, REVERSED
  reversal       PaymentReversal?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([confirmedAt])
  @@index([method, confirmedAt])
  @@index([status, confirmedAt])
}

model PaymentReversal {
  id             String         @id @default(cuid())
  receiptId      String         @unique
  receipt        PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  reason         String
  revertedById   String
  revertedBy     User           @relation("RevertedReceipts", fields: [revertedById], references: [id], onDelete: Restrict)
  revertedAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([revertedAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("INFO") // INFO, REMINDER, ALERT, CANCEL, NO_SHOW
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read, createdAt])
}
